# Copy this file to .env and fill in real values.
# Set the same vars in the Vercel/Render dashboard for production.

# ── Cloudflare D1 (HTTP API) ─────────────────────────────────────
# Account ID: Cloudflare dashboard → right sidebar on any page
CLOUDFLARE_ACCOUNT_ID=

# Database ID: dashboard → Storage & Databases → D1 → your database,
# or create one with:  npx wrangler d1 create rupeeflow-db
CLOUDFLARE_DATABASE_ID=

# API token: dashboard → My Profile → API Tokens → Create Token
# → Custom token with permission  Account · D1 · Edit
CLOUDFLARE_D1_TOKEN=

# ── App secrets ──────────────────────────────────────────────────
# Any long random string — signs login tokens
JWT_SECRET=

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
